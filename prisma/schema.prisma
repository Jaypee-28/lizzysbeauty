generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  password      String?
  name          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  emailVerified DateTime?  @map("email_verified")
  image         String?
  isBanned      Boolean    @default(false)
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Admin {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(ADMIN)
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admins")
}

model Service {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String
  imageUrl          String?
  duration          Int       @default(60) // in minutes
  fullPrice         Decimal   @default(0) @db.Decimal(10, 2)
  depositPercentage Int       @default(50)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]

  @@map("services")
}

model Booking {
  id                    String        @id @default(cuid())
  serviceId             String        @map("service_id")
  email                 String
  phone                 String
  status                BookingStatus @default(PENDING)
  fullPrice             Decimal       @default(0) @db.Decimal(10, 2)
  depositPaid           Decimal       @default(0) @db.Decimal(10, 2)
  outstandingBalance    Decimal       @default(0) @db.Decimal(10, 2)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  name                  String
  notes                 String?
  preferredDate         DateTime      @map("preferred_date")
  preferredTime         String        @map("preferred_time")
  service               Service       @relation(fields: [serviceId], references: [id])

  @@map("bookings")
}

model Setting {
  id               String   @id @default(cuid())
  storeName        String?
  supportEmail     String?
  heroVideoUrl     String?
  heroTopLabel     String?
  heroTitle        String?
  heroWords        Json?
  heroSubtitle     String?
  heroPrimaryCTA   String?
  heroSecondaryCTA String?
  bookingPolicy    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  currency         String   @default("USD")

  @@map("settings")
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  email      String
  message    String
  rating     Int?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

model GalleryImage {
  id         String   @id @default(cuid())
  url        String
  caption    String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("gallery_images")
}

